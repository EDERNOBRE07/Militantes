# Configuração Apache / Hostinger para Single Page Application (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Não reescrever se a requisição for o próprio index.html
  RewriteRule ^index\.html$ - [L]

  # 2. Não reescrever se o arquivo ou diretório existir fisicamente no disco
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Encaminha todas as outras rotas para o index.html sem loop
  RewriteRule . /index.html [L]
</IfModule>

# MIME Types para carregamento correto de Scripts e Estilos
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/svg+xml .svg
</IfModule>

# Desativa Directory Listing por segurança
Options -Indexes

